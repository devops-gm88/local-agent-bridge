    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// State comes from the Exceptions tab, read once per run by \"Read Exceptions\".\n// The Sheet is the durable store: it survives restarts, n8n upgrades and the JS\n// task runner (workflow static data does not survive the runner).\nconst stateItems = $input.all().map((i) => i.json).filter((j) => j && j.intake_id);\nconst state = {};\nfor (const row of stateItems) {\n  const key = String(row.intake_id || '').trim();\n  if (key) state[key] = row;\n}\nconst ADMIN = String('owner@example.com').toLowerCase();\n\nfunction unique(list) {\n  const seen = new Set();\n  const out = [];\n  for (const x of list) {\n    const v = String(x || '').trim().toLowerCase();\n    if (v && !seen.has(v)) { seen.add(v); out.push(v); }\n  }\n  return out;\n}\n\nconst messages = $('Get Full Message').all().map((i) => i.json).filter((j) => j && j.id);\nconst out = [];\n\nfor (let i = 0; i < messages.length; i++) {\n  const item = messages[i];\n  const headers = item.headers || {};\n  const subject = String(item.subject || item.Subject || headers.subject || headers.Subject || '')\n    .replace(/^Subject:\\s*/i, '');\n\n  let body = String(item.text || item.textAsHtml || item.snippet || '');\n  body = body.replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ');\n\n  // Drop the quoted original so a quoted APPROVE cannot count as a decision.\n  const fresh = [];\n  for (const line of body.split(/\\r?\\n/)) {\n    if (/^\\s*>/.test(line)) break;\n    if (/^\\s*On .+wrote:\\s*$/i.test(line)) break;\n    if (/^\\s*-{2,}\\s*Original Message\\s*-{2,}/i.test(line)) break;\n    if (/^\\s*From:\\s+/i.test(line)) break;\n    fresh.push(line);\n  }\n  const replyText = fresh.join('\\n').trim();\n  const head = replyText.split('\\n').map((l) => l.trim()).filter(Boolean).slice(0, 4).join(' ');\n\n  const isReply = /^\\s*re\\s*:/i.test(subject);\n  const decisionMatch = isReply ? head.match(/\\b(APPROVE|APPROVED|REJECT|REJECTED)\\b/i) : null;\n  const decision = decisionMatch ? decisionMatch[1].toUpperCase().replace(/D$/, '') : '';\n  const overrideMatch = isReply ? head.match(/\\bOVERRIDE\\b[^A-Za-z]*(APPROVE|APPROVED|REJECT|REJECTED)\\b/i) : null;\n  const overrideDecision = overrideMatch ? overrideMatch[1].toUpperCase().replace(/D$/, '') : '';\n  const effective = overrideDecision || decision;\n\n  const intakeMatch = (subject + '\\n' + body).match(/INTAKE-[A-Z0-9]+/);\n  const intakeId = intakeMatch ? intakeMatch[0] : '';\n\n  const senderList = (item.from && item.from.value) || [];\n  const responder = String(\n    (senderList[0] && (senderList[0].address || senderList[0].name))\n    || headers.from || item.from || ''\n  ).trim();\n  const responderKey = responder.toLowerCase();\n  const isAdmin = Boolean(responderKey) && responderKey === ADMIN;\n\n  const row = intakeId ? state[intakeId] : undefined;\n  const prior = row\n    ? {\n        status: String(row.approval_status || '').toUpperCase(),\n        decision: String(row.decision || '').toUpperCase(),\n        decided_by: String(row.decided_by || '').toLowerCase(),\n        at: String(row.decided_at || ''),\n        message_id: String(row.decision_message_id || ''),\n      }\n    : undefined;\n\n  let route = 'ignore';\n  if (isReply && intakeId) {\n    if (overrideDecision && isAdmin) {\n      route = 'admin_override';\n    } else if (!effective) {\n      route = 'ignore';\n    } else if (!prior || !prior.status) {\n      route = 'decide';\n    } else if (prior.status === 'CONFLICT') {\n      route = isAdmin ? 'admin_override' : 'conflict_locked';\n    } else if (prior.decided_by === responderKey) {\n      route = prior.decision === effective ? 'duplicate' : 'change';\n    } else if (prior.decision === effective) {\n      route = 'agree';\n    } else {\n      route = 'conflict';\n    }\n  }\n\n  const now = new Date().toISOString();\n  const messageId = String(item.id || '');\n  const vendor = (row && row.vendor) || '';\n  const amount = row && row.amount !== undefined ? row.amount : '';\n  const noticeTo = unique([prior && prior.decided_by, responderKey, ADMIN]).join(', ');\n  const shottyApprovalId = row ? String(row.shotty_approval_id || '') : '';\n\n  out.push({\n    pairedItem: { item: i },\n    json: {\n      route,\n      intake_id: intakeId,\n      decision: effective,\n      responder,\n      responder_key: responderKey,\n      is_admin: isAdmin,\n      reply_subject: subject,\n      subject: subject,\n      message_id: messageId,\n      decided_at: now,\n      shotty_approval_id: shottyApprovalId,\n      override_note: overrideDecision ? head.replace(/\\s+/g, ' ').slice(0, 200) : '',\n      prior_decision: prior ? prior.decision : '',\n      prior_by: prior ? prior.decided_by : '',\n      prior_at: prior ? prior.at : '',\n      prior_message: prior ? prior.message_id : '',\n      prior_status: prior ? prior.status : '',\n      notice_to: noticeTo,\n      // Exceptions columns (names must match the header row)\n      approval_status: route === 'conflict' || route === 'conflict_locked' ? 'CONFLICT' : effective,\n      decided_by: responderKey,\n      decision_message_id: messageId,\n      // Decisions columns\n      vendor,\n      amount,\n      status: route,\n      message_id_log: messageId,\n    },\n  });\n}\n\nreturn out;\n"
      },
